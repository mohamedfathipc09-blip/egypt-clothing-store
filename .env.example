# ==========================================
# 1. الإعدادات العامة للتطبيق
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ==========================================
# 2. إعدادات قاعدة بيانات Supabase
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# تحذير أمني: هذا المفتاح سري للغاية ولا يستخدم إلا على الخادم فقط (Server-only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# ==========================================
# 3. إعدادات WhatsApp Business Cloud API الرسمية
# (في حال تركها فارغة يعمل النظام في وضع الانتظار/الاختبار دون إسقاط الطلبات)
# ==========================================
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ADMIN_RECIPIENT_PHONE=

# ==========================================
# 4. حماية المهام المجدولة (Outbox Worker)
# ==========================================
CRON_SECRET=replace-with-strong-random-32-char-string